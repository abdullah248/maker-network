// Maker Network data model.
//
// Provider = "sqlite" keeps local dev + CI dependency-free. The schema deliberately
// avoids SQLite-only constructs (no native enums, no scalar lists) so the same models
// can be pointed at PostgreSQL by swapping the datasource block.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // "CUSTOMER" | "MAKERSPACE" | "INDIVIDUAL" -- see AccountType in src/lib/constants.ts
  accountType   String    @default("CUSTOMER")
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  sentMessages  Message[]
  conversations Conversation[] @relation("ConversationRequester")
  bookedSlots   AvailabilitySlot[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Provider profiles
// ---------------------------------------------------------------------------

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  // "MAKERSPACE" | "INDIVIDUAL"
  type        String
  slug        String  @unique
  displayName String
  headline    String?
  bio         String?
  avatarUrl   String?

  // General location: city-level only, never a street address.
  city        String
  region      String?
  country     String  @default("US")
  postalCode  String?
  latitude    Float?
  longitude   Float?

  websiteUrl   String?
  contactEmail String?
  phone        String?

  // Makerspace access rules
  requiresAppointment Boolean @default(false)
  requiresMembership  Boolean @default(false)
  requiresLibraryCard Boolean @default(false)
  membershipDetails   String?
  accessNotes         String?

  // Individual maker fulfilment
  offersShipping          Boolean @default(false)
  offersLocalPickup       Boolean @default(true)
  canCustomOrderMaterials Boolean @default(false)
  customOrderNotes        String?

  acceptingRequests Boolean  @default(true)
  published         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  machines       Machine[]
  materials      Material[]
  operatingHours OperatingHours[]
  availability   AvailabilitySlot[]
  conversations  Conversation[]     @relation("ConversationProvider")

  @@index([type, published])
  @@index([city])
}

model Machine {
  id        String  @id @default(cuid())
  profileId String
  // MachineCategory in src/lib/constants.ts
  category  String
  make      String
  model     String
  isCustom  Boolean @default(false)
  nickname  String?

  buildVolume   String?
  quantity      Int     @default(1)
  hourlyRate    Float?
  perJobFee     Float?
  notes         String?
  isOperational Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  availability AvailabilitySlot[]
  requests     PrintRequest[]

  @@index([profileId])
  @@index([category])
}

model Material {
  id        String  @id @default(cuid())
  profileId String
  // MaterialCategory in src/lib/constants.ts
  category  String
  name      String
  brand     String?

  // Comma-separated colour list; kept as text so the schema stays portable.
  colors              String?
  // Free-form technical specs (diameter, thickness, density, tolerances...).
  specs               String?
  // MaterialUnit in src/lib/constants.ts
  unit                String  @default("KG")
  pricePerUnit        Float   @default(0)
  currency            String  @default("USD")
  stockQuantity       Int?
  inStock             Boolean @default(true)
  canCustomOrder      Boolean @default(false)
  customOrderLeadDays Int?
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile  Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  requests PrintRequest[]

  @@index([profileId])
  @@index([category])
}

model OperatingHours {
  id        String  @id @default(cuid())
  profileId String
  // 0 = Sunday ... 6 = Saturday
  dayOfWeek Int
  // Minutes since midnight, local to the profile.
  opensAt   Int     @default(540)
  closesAt  Int     @default(1020)
  isClosed  Boolean @default(false)
  note      String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayOfWeek])
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  profileId String
  machineId String?
  startsAt  DateTime
  endsAt    DateTime
  // "OPEN" | "BOOKED" | "BLOCKED"
  status    String   @default("OPEN")
  capacity  Int      @default(1)
  note      String?

  bookedByUserId String?
  bookedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  machine  Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  bookedBy User?    @relation(fields: [bookedByUserId], references: [id], onDelete: SetNull)

  @@index([profileId, startsAt])
  @@index([machineId])
}

// ---------------------------------------------------------------------------
// Messaging + requests
// ---------------------------------------------------------------------------

model Conversation {
  id                String   @id @default(cuid())
  requesterId       String
  providerProfileId String
  subject           String
  lastMessageAt     DateTime @default(now())
  requesterArchived Boolean  @default(false)
  providerArchived  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  requester       User          @relation("ConversationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  providerProfile Profile       @relation("ConversationProvider", fields: [providerProfileId], references: [id], onDelete: Cascade)
  messages        Message[]
  request         PrintRequest?

  @@index([requesterId, lastMessageAt])
  @@index([providerProfileId, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model PrintRequest {
  id             String  @id @default(cuid())
  conversationId String  @unique
  machineId      String?
  materialId     String?

  title       String
  description String
  quantity    Int       @default(1)
  // "SHIPPING" | "PICKUP" | "EITHER"
  fulfillment String    @default("PICKUP")
  budgetCents Int?
  deadline    DateTime?
  fileUrl     String?
  // "OPEN" | "ACCEPTED" | "DECLINED" | "COMPLETED" | "CANCELLED"
  status      String    @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  machine      Machine?     @relation(fields: [machineId], references: [id], onDelete: SetNull)
  material     Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([status])
}
